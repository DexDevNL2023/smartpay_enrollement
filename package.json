{
  "name": "smart_pay_web_app_tests",
  "version": "1.0.0",
  "main": "index.js",
  "description": "Tests E2E Web Angular et Vue avec Cypress et Cucumber",
  "scripts": {
    "start": "ng serve",
    "cy:open": "cypress open",
    "clean:reports": "node cypress/support/node_fs/removeDir.js",
    "create:reports": "node cypress/support/node_fs/createDir.js",
    "archive-report": "node cypress/support/node_fs/archiveReport.js",
    "cy:run": "cypress run --browser chrome",
    "pretest": "npm-run-all clean:reports create:reports",
    "start-and-test": "npm-run-all --parallel cy:run",
    "test": "npm-run-all archive-report pretest start-and-test && mochawesome-merge cypress/reports/*.json > cypress/reports/report.json && npx mochawesome-report-generator cypress/reports/report.json -f html,md -o cypress/reports"
  },
  "dependencies": {
    "@angular-devkit/build-angular": "^20.2.0",
    "@angular/cli": "^20.2.0",
    "@angular/common": "^20.2.1",
    "@angular/core": "^20.2.1",
    "@angular/platform-browser-dynamic": "^20.2.1",
    "@badeball/cypress-cucumber-preprocessor": "^23.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.5",
    "dotenv": "^17.2.2",
    "esbuild": "^0.25.9",
    "glob": "^11.0.3",
    "imap-simple": "^5.1.0",
    "mailparser": "^3.7.4",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.2.0",
    "mochawesome-screenshots": "^1.7.3",
    "npm-run-all": "^4.1.5"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.2.0",
    "@angular/cli": "^20.2.0",
    "@angular/common": "^20.2.1",
    "@angular/core": "^20.2.1",
    "@angular/platform-browser-dynamic": "^20.2.1",
    "@badeball/cypress-cucumber-preprocessor": "^23.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.5",
    "cypress": "^16.0.0",
    "cypress-wait-until": "^3.0.2",
    "esbuild": "^0.25.9",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.2.0",
    "mochawesome-screenshots": "^1.7.3",
    "npm-run-all": "^4.1.5",
    "twilio": "^5.9.0"
  }
}
